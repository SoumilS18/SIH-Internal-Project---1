# =============================================================================
# AgriOptima AI Environment Configuration Template
# =============================================================================
#
# DO NOT commit real keys to version control.
# Copy this file to '.env' and fill in your real credentials.

# -----------------------------------------------------------------------------
# 1. FRONTEND PUBLIC CREDENTIALS (Safe for browser / Vercel deployment)
# -----------------------------------------------------------------------------
# Supabase Project URL and Anon/Public Key (found in Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend REST API endpoint (points frontend to Render or localhost)
VITE_API_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY PRIVATE SECRETS (Render / Backend deployment only)
# -----------------------------------------------------------------------------
# Google Gemini API key (for Farm Advisory LLM reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API subscription key (for Hindi/Indic voice STT and TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: OpenAI API key (if alternate reasoning models are configured)
OPENAI_API_KEY=your_openai_api_key_here

# Package Manager link mode
UV_LINK_MODE=copy

